<mxfile host="app.diagrams.net"><diagram name="Encaminhamento de dúvidas"><mxGraphModel dx="900" dy="900" grid="1" gridSize="10" page="1" pageWidth="850" pageHeight="950"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="start" value="Estudante envia a dúvida&#xa;(fórum, chat do AVA ou e-mail)" style="rounded=1;arcSize=50;fillColor=#E8EEF7;strokeColor=#3B5B8C;whiteSpace=wrap;html=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="270" y="16" width="260" height="52" as="geometry"/></mxCell><mxCell id="d1" value="É sensível ou avaliativa?&#xa;(nota, saúde, dado pessoal,&#xa;conflito, pede humano)" style="rhombus;fillColor=#FFF4D6;strokeColor=#A87B00;whiteSpace=wrap;html=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="270" y="100" width="260" height="110" as="geometry"/></mxCell><mxCell id="prof" value="PROFESSOR (N3)&#xa;resposta reservada · até 48h úteis" style="rounded=1;fillColor=#F6E3EC;strokeColor=#8C2F5B;whiteSpace=wrap;html=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="600" y="123" width="200" height="64" as="geometry"/></mxCell><mxCell id="d2" value="É administrativa ou&#xa;está na FAQ?" style="rhombus;fillColor=#FFF4D6;strokeColor=#A87B00;whiteSpace=wrap;html=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="270" y="240" width="260" height="100" as="geometry"/></mxCell><mxCell id="tvfaq" value="TUTOR VIRTUAL (N1)&#xa;resposta da FAQ + link oficial" style="rounded=1;fillColor=#E3F1EA;strokeColor=#2F7A55;whiteSpace=wrap;html=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="378" width="220" height="64" as="geometry"/></mxCell><mxCell id="tvexp" value="TUTOR VIRTUAL (N1)&#xa;explicação guiada pelo material" style="rounded=1;fillColor=#E3F1EA;strokeColor=#2F7A55;whiteSpace=wrap;html=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="378" width="220" height="64" as="geometry"/></mxCell><mxCell id="d3" value="Resolveu em até&#xa;2 tentativas?" style="rhombus;fillColor=#FFF4D6;strokeColor=#A87B00;whiteSpace=wrap;html=0